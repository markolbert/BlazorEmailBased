@typeparam TItem

@implements IDisposable

@using Microsoft.Extensions.Options

@inject IOptionsMonitor<SiteSettings> SiteSettingsMonitor

@if (Items.Count > ItemsPerPage)
{
    <div class="pagination">
        <div>
            @if( PageNum > 0 )
            {
                <span class="paging" @onclick="async () => await ChangePageAsync( -PageNum )">|&lt;&nbsp;</span>
                <span class="paging" @onclick="async () => await ChangePageAsync( -1 )">&lt;</span>
            }
            else
            {
                <span class="non-paging">|&lt;&nbsp;</span>
                <span class="non-paging">&lt;</span>
            }
        </div>

        <div>
            @if( PageNum < ( Items.Count - 1 ) / ItemsPerPage )
            {
                <span class="paging" @onclick="async () => await ChangePageAsync( 1 )">&gt;&nbsp;</span>
                <span class="paging" @onclick="async () => await ChangePageAsync( ( Items.Count - 1 ) / ItemsPerPage )">&gt;|</span>
            }
            else
            {
                <span class="non-paging">&gt;&nbsp;</span>
                <span class="non-paging">&gt;|</span>
            }
        </div>
    </div>
}


@code {

    [ Parameter ]
    public List<TItem> Items { get; set; } = [];

    [ Parameter ]
    public int ItemsPerPage
    {
        get;

        set
        {
            field = value;
            _customItemsPerPage = true;
        }
    } = 5;

    [ Parameter ]
    public int PageNum { get; set; }

    [ Parameter ]
    public EventCallback<int> PageNumChanged { get; set; }

    private IDisposable? _changeSubscription;
    private bool _customItemsPerPage;

    protected override void OnInitialized()
    {
        ItemsPerPage = SiteSettingsMonitor.CurrentValue.ItemsPerPage;

        _changeSubscription = SiteSettingsMonitor.OnChange( updated =>
        {
            if( _customItemsPerPage )
                return;

            ItemsPerPage = updated.ItemsPerPage;

            // The notification may arrive outside this component's renderer context.
            _ = InvokeAsync( StateHasChanged );
        } );
    }

    private async Task ChangePageAsync(int delta)
    {
        PageNum += delta;

        await PageNumChanged.InvokeAsync( PageNum );

        StateHasChanged();
    }

    public void Dispose()
    {
        _changeSubscription?.Dispose();
    }
}