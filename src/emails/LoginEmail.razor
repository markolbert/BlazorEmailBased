@* LoginEmail.razor *@
<div style="width: 100%; max-width: 600px; margin: 0 auto; font-family: Arial, sans-serif;">

    <h2 style="width: fit-content; padding: 20px; background-color: #4CAF50; color: white; padding: 15px; text-align: left; font-size: 24px;">
        @TagLine
    </h2>

    <div style="padding: 20px; color: #333333; line-height: 1.5;">
        <p style="margin-bottom: 20px;">Hello <strong>@Name</strong>,</p>

        <p style="margin-bottom: 20px;">
            Please click this link to log in:
            <a href="@VerificationLink" style="display: inline-block; color: #ffffff; text-decoration: none; border-top: 12px solid #008CBA; border-bottom: 12px solid #008CBA; border-left: 24px solid #008CBA; border-right: 24px solid #008CBA; background-color: #008CBA;">
                @AccessSlug
            </a>
        </p>
    </div>

    @if( AdminImpersonating )
    {
        <p style="margin-bottom: 20px; color: firebrick; font-style: italic;">
            The designated Administrator account is impersonating this user.
        </p>
    }

    <div style="padding: 20px; color: #333333; line-height: 1.5;">
        <p style="margin-bottom: 20px;">
            If you did <span style="font-weight:bold; font-size: 18px;">not</span> request this login, please click this link to report it:
            <a href="@LockOutLink" style="display: inline-block; color: #ffffff; text-decoration: none; border-top: 12px solid #9C2113; border-bottom: 12px solid #9C2113; border-left: 24px solid #9C2113; border-right: 24px solid #9C2113; background-color: #9C2113;">
                Report Malicious Login Attempt
            </a>
        </p>
    </div>

</div>

@code {

    [ Parameter ]
    public string Name { get; set; } = string.Empty;

    [ Parameter ]
    public string TagLine { get; set; } = string.Empty;

    [Parameter]
    public string AccessSlug { get; set; } = string.Empty;

    [ Parameter ]
    public bool AdminImpersonating { get; set; }

    [ Parameter ]
    public string VerificationLink { get; set; } = string.Empty;

    [ Parameter ]
    public string LockOutLink { get; set; } = string.Empty;

}