@* LockedOutEmail.razor *@

<div style="width: 100%; max-width: 600px; margin: 0 auto; font-family: Arial, sans-serif;">

    <h2 style="width: fit-content; padding: 20px; background-color: #4CAF50; color: white; padding: 15px; text-align: left; font-size: 24px;">
        @EmailProperties.SiteName
    </h2>

    <p style="margin-bottom: 20px;">
        <strong>@EmailProperties.Name</strong> has been locked out at their request.
    </p>

</div>

@code {
    [Parameter]
    public required ILockOutEmailSettings EmailProperties { get; set; }
}